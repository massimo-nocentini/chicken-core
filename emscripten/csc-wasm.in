#   Redistributions of source code must retain the above copyright notice, this list of conditions and the following
#     disclaimer.
#   Redistributions in binary form must reproduce the above copyright notice, this list of conditions and the following
#     disclaimer in the documentation and/or other materials provided with the distribution.
#   Neither the name of the author nor the names of its contributors may be used to endorse or promote
#     products derived from this software without specific prior written permission.
#
# THIS SOFTWARE IS PROVIDED BY THE COPYRIGHT HOLDERS AND CONTRIBUTORS "AS IS" AND ANY EXPRESS
# OR IMPLIED WARRANTIES, INCLUDING, BUT NOT LIMITED TO, THE IMPLIED WARRANTIES OF MERCHANTABILITY
# AND FITNESS FOR A PARTICULAR PURPOSE ARE DISCLAIMED. IN NO EVENT SHALL THE COPYRIGHT HOLDERS OR
# CONTRIBUTORS BE LIABLE FOR ANY DIRECT, INDIRECT, INCIDENTAL, SPECIAL, EXEMPLARY, OR
# CONSEQUENTIAL DAMAGES (INCLUDING, BUT NOT LIMITED TO, PROCUREMENT OF SUBSTITUTE GOODS OR
# SERVICES; LOSS OF USE, DATA, OR PROFITS; OR BUSINESS INTERRUPTION) HOWEVER CAUSED AND ON ANY
# THEORY OF LIABILITY, WHETHER IN CONTRACT, STRICT LIABILITY, OR TORT (INCLUDING NEGLIGENCE OR
# OTHERWISE) ARISING IN ANY WAY OUT OF THE USE OF THIS SOFTWARE, EVEN IF ADVISED OF THE
# POSSIBILITY OF SUCH DAMAGE.
#
# Generated by "make wasm" (goal wasm-sdk) from emscripten/csc-wasm.in.
#
# usage: csc-wasm [-node] [OPTION ...] FILE.scm ... [-o OUT.js]
#
# A small csc for the WebAssembly SDK: the host chicken translates each
# Scheme file to C, emcc compiles it with the flags libchicken was built
# with and links it statically against libchicken-static.a.  Options:
#
#   -node               link for node (host file system and environment,
#                       exit status); by default emcc's defaults apply
#                       (web, worker or node, in-memory file system)
#   -o FILE             output file (default: first source file, .js)
#   -c / -t             stop after compiling to FILE.o / translating to FILE.c
#   -k                  keep the intermediate .c and .o files (in the cwd)
#   -v                  show the commands run
#   -e -embedded        compile with -DC_EMBEDDED (no main)
#   -C OPTIONS          extra emcc compile options
#   -L OPTIONS          extra emcc link options
#   -O0 ... -O5, -d0 ... -d3, -D FEATURE, -I DIR, -j MODULE, -J, -u,
#   -b, -w, -A, -types FILE, -oi FILE, -ot FILE, -X FILE, -R EXT
#                       as in csc
#   *.c                 compiled with emcc; *.o *.a linked
#   -sSETTING=V, -lLIB, -LDIR, -IDIR, -Wl,..., --EMCC-OPTION [ARG]
#                       passed to emcc
#   anything else       passed to chicken (e.g. -uses UNIT, -unit NAME,
#                       -specialize, -unsafe, -feature F)
#
# Programs are always linked statically: every unit they use must be in
# libchicken or named on the command line.  The host chicken reads import
# libraries and types.db from the SDK repository.

set -e

S='@STAGE@'
REPO='@REPO@'
CHICKEN='@CHICKEN@'
EMCC='@EMCC@'

CF=$(cat "$S/share/chicken/emcflags")
LF=$(cat "$S/share/chicken/emldflags")

# q ARG: ARG quoted for eval
q() {
    printf "'%s'" "$(printf '%s' "$1" | sed "s/'/'\\\\''/g")"
}

NODE_LF="-sENVIRONMENT=node -sNODERAWFS=1 -sNODE_HOST_ENV=1 -sEXIT_RUNTIME=1 --pre-js $(q "$S/share/chicken/node-pre.js")"

die() {
    echo "csc-wasm: $*" >&2
    exit 64
}

# run COMMAND ...: run (and with -v show) a command
run() {
    if test -n "$verbose"; then echo "$*" >&2; fi
    "$@"
}

scheme_files=
c_files=
object_files=
chicken_opts=
cc_opts=
ld_opts=
out=
mode=link
node=
keep=
verbose=

# copt ARG ...: add chicken options
copt() {
    for a; do chicken_opts="$chicken_opts $(q "$a")"; done
}

while test $# -gt 0; do
    arg=$1; shift
    case $arg in
	-node) node=1 ;;
	-o|-output-file)
	    test $# -gt 0 || die "missing argument to $arg"
	    out=$1; shift ;;
	-c) mode=compile ;;
	-t) mode=translate ;;
	-k) keep=1 ;;
	-v|-verbose) verbose=1; copt -verbose ;;
	-e|-embedded) cc_opts="$cc_opts -DC_EMBEDDED" ;;
	-A|-analyze-only) mode=analyze; copt -analyze-only ;;
	-P|-check-syntax) mode=analyze; copt -check-syntax ;;
	-w|-no-warnings) cc_opts="$cc_opts -w"; copt -no-warnings ;;
	-static) ;;
	-s|-shared|-dynamic|-dll|-library)
	    die "$arg: dynamic loading is not supported on WebAssembly" ;;
	-O|-O1) copt -optimize-level 1 ;;
	-O[0-5]) copt -optimize-level "${arg#-O}" ;;
	-d[0-3]) copt -debug-level "${arg#-d}" ;;
	-u) copt -unsafe ;;
	-b) copt -block ;;
	-f) copt -fixnum-arithmetic ;;
	-i) copt -case-insensitive ;;
	-x) copt -explicit-use ;;
	-J) copt -emit-all-import-libraries ;;
	-M) copt -module-registration ;;
	-N) copt -no-module-registration ;;
	-C)
	    test $# -gt 0 || die "missing argument to $arg"
	    cc_opts="$cc_opts $1"; shift ;;
	-L)
	    test $# -gt 0 || die "missing argument to $arg"
	    ld_opts="$ld_opts $1"; shift ;;
	-D|-feature|-I|-include-path|-j|-emit-import-library|-m|-module|-K|-keyword-style|\
	-X|-extend|-R|-require-extension|-types|-consult-types-file|-oi|-emit-inline-file|\
	-ot|-emit-types-file|-debug|-heap-size|-nursery|-stack-size|-unit|-uses|\
	-optimize-level|-database-size|-prelude|-postlude|-prologue|-epilogue|\
	-emit-link-file|-inline-limit|-profile-name|-unroll-limit|-consult-inline-file|\
	-debug-level|-link|-no-feature)
	    test $# -gt 0 || die "missing argument to $arg"
	    case $arg in
		-D) arg=-feature ;;
		-I) arg=-include-path ;;
		-j) arg=-emit-import-library ;;
		-m) arg=-module ;;
		-K) arg=-keyword-style ;;
		-X) arg=-extend ;;
		-R) arg=-require-extension ;;
		-types) arg=-consult-types-file ;;
		-oi) arg=-emit-inline-file ;;
		-ot) arg=-emit-types-file ;;
		-link) die "-link: use -uses UNIT and name the object file instead" ;;
	    esac
	    copt "$arg" "$1"; shift ;;
	-D?*) copt -feature "${arg#-D}" ;;
	-local|-lfa2) copt "$arg" ;;
	-s[A-Z]*|-l?*|-L?*|-Wl,*) ld_opts="$ld_opts $(q "$arg")" ;;
	-I?*) cc_opts="$cc_opts $(q "$arg")" ;;
	--embed-file|--preload-file|--exclude-file|--pre-js|--post-js|--extern-pre-js|\
	--extern-post-js|--js-library|--shell-file|--closure-args)
	    test $# -gt 0 || die "missing argument to $arg"
	    ld_opts="$ld_opts $(q "$arg") $(q "$1")"; shift ;;
	--*) ld_opts="$ld_opts $(q "$arg")" ;;
	-*) copt "$arg" ;;
	*.c) c_files="$c_files $(q "$arg")" ;;
	*.o|*.a) object_files="$object_files $(q "$arg")" ;;
	*)
	    if test ! -f "$arg" && test -f "$arg.scm"; then arg=$arg.scm; fi
	    test -f "$arg" || die "no such file: $arg"
	    scheme_files="$scheme_files $(q "$arg")" ;;
    esac
done

eval "set -- $scheme_files $c_files $object_files"
test $# -gt 0 || die "no source files specified"
first=$1
base=$(basename "$first"); base=${base%.*}
if test -z "$out"; then
    case $mode in
	compile) out=$base.o ;;
	translate) out=$base.c ;;
	*) out=$base.js ;;
    esac
fi
if test $mode = translate; then
    eval "set -- $scheme_files $c_files $object_files"
    test $# -eq 1 && test -n "$scheme_files" || die "-t takes exactly one Scheme file"
elif test $mode = compile; then
    eval "set -- $scheme_files $c_files"
    test $# -eq 1 || die "-c takes exactly one Scheme or C file"
fi
eval "set -- $scheme_files $c_files $object_files"
for f; do
    test "x$f" != "x$out" || die "the output file $out is also an input file"
done

if test -n "$keep"; then
    work=.
else
    work=$(mktemp -d "${TMPDIR:-/tmp}/csc-wasm.XXXXXX")
    trap 'rm -rf "$work"' EXIT
    trap 'exit 1' HUP INT TERM
fi

# The host chicken finds the target's import libraries and types.db here.
CHICKEN_REPOSITORY_PATH=$REPO${CHICKEN_REPOSITORY_PATH:+:$CHICKEN_REPOSITORY_PATH}
export CHICKEN_REPOSITORY_PATH

# The translator runs on the host.  Features can only be added for the
# target, as in CHICKEN's own cross-compilation: the compiler asks
# (feature? #:64bit) about itself, e.g. to emit fixnum literals that do
# not fit in 31 bits portably, so the host's word size and platform
# features stay visible to cond-expand.
target_features='-static -feature emscripten -feature wasm32'

# stem FILE: set b to FILE's base name without its extension, made
# unique among the inputs (app.scm and app.c, or a/m.scm and b/m.scm),
# so that no two inputs share an intermediate file
taken='
'
stem() {
    b=$(basename "$1"); b=${b%.*}
    s=$b; i=1
    while case $taken in *"
$b
"*) true ;; *) false ;; esac; do
	i=$((i + 1)); b=$s-$i
    done
    taken="$taken$b
"
}

# C files first, so that with -k a translated Scheme file never takes
# the name of a C file given alongside it
c_objects=
if test $mode != analyze; then
    eval "set -- $c_files"
    for f; do
	stem "$f"
	o=$work/$b.o
	if test $mode = compile; then o=$out; fi
	eval "run $EMCC $CF -DHAVE_CHICKEN_CONFIG_H -I\"\$S/include/chicken\" $cc_opts -c \"\$f\" -o \"\$o\""
	c_objects="$c_objects $(q "$o")"
    done
fi
test $mode = compile && test -n "$c_objects" && exit 0

objects=
eval "set -- $scheme_files"
for f; do
    stem "$f"
    c=$work/$b.c
    if test $mode = translate; then c=$out; fi
    if test $mode = analyze; then
	eval "run $CHICKEN \"\$f\" $target_features $chicken_opts"
	continue
    fi
    eval "run $CHICKEN \"\$f\" $target_features $chicken_opts -output-file \"\$c\""
    test $mode = translate && exit 0
    o=$work/$b.o
    if test $mode = compile; then o=$out; fi
    eval "run $EMCC $CF -DHAVE_CHICKEN_CONFIG_H -I\"\$S/include/chicken\" $cc_opts -c \"\$c\" -o \"\$o\""
    objects="$objects $(q "$o")"
done
test $mode = analyze && exit 0
test $mode = compile && exit 0

if test -n "$node"; then ld_opts="$NODE_LF $ld_opts"; fi
eval "run $EMCC $LF $objects $c_objects $object_files \"\$S/lib/libchicken-static.a\" -lm $ld_opts -o \"\$out\""
