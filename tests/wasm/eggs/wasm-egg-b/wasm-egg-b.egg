; Two extensions, one using the other, on top of wasm-egg-a (and the
; files it installs); srfi-4 is provided by the core system, and r7rs
; is mapped away by setup.defaults.  The components are in a toplevel
; cond-expand, and another cond-expand clause selects the option for
; the WebAssembly target.

((synopsis "WebAssembly egg test: dependencies")
 (version "0.3")
 (license "BSD")
 (category testing)
 (dependencies (wasm-egg-a "1.0") srfi-4 r7rs)
 (test-dependencies wasm-egg-no-such-egg)
 (component-options
  (csc-options "-O3" "-d1"))
 (cond-expand
   (chicken-6
    (components
     (extension wasm-egg-b-core
       (source "b-core.scm")
       (source-dependencies "b-helpers.scm"))
     (extension wasm-egg-b
       (component-dependencies wasm-egg-b-core)
       (cond-expand
         ((and target wasm32) (csc-options "-D" "wasm-egg-b-target"))
         (else (error "wasm-egg-b: not built for the WebAssembly target"))))))
   (else (error "wasm-egg-b: needs CHICKEN 6"))))
