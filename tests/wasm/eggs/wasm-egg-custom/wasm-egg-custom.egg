; A custom build script cannot be run for WebAssembly: planning a build
; with this egg must fail, naming the egg and the reason.

((synopsis "WebAssembly egg test: a custom build step")
 (license "BSD")
 (category testing)
 (components
  (extension wasm-egg-custom
    (custom-build "build-wasm-egg-custom"))))
