; Its build-dependency, wasm-egg-tool, is used at build time, on the
; host, where it must be installed (the eggs lane makes a host
; repository holding its compiled import library and .egg-info).  It
; is built for the target too, as the import of its module needs its
; unit at run time, even if only its syntax is used.

((synopsis "WebAssembly egg test: a build-dependency")
 (version "0.1")
 (license "BSD")
 (category testing)
 (build-dependencies (wasm-egg-tool "1.0"))
 (components
  (extension wasm-egg-c)))
