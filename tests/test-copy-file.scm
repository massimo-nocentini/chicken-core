(import (chicken file)
        (chicken file posix)
        (chicken pathname))

(delete-file* "library.o.copy")
(let* ((orig-library (make-pathname ".." "library.o"))
       (orig-size (file-size orig-library)))
  (copy-file orig-library "library.o.copy")
  (let ((copy-size (file-size "library.o.copy")))
    (delete-file "library.o.copy")
    (assert (= orig-size copy-size))))
