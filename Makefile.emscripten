#
# This platform is always built out of tree, driven by "make wasm" from a
# configured and built host tree (see the "wasm" targets at the end of
# rules.make and the README).  The host tree's "chicken" translates the
# Scheme sources; everything else here is compiled with emcc.

SRCDIR ?= ./

ifeq ($(abspath $(SRCDIR)),$(CURDIR))
$(error PLATFORM=emscripten must be built out of tree: run "make wasm" from a configured host tree)
endif
ifeq ($(origin CHICKEN),undefined)
$(error CHICKEN must name a host chicken (written to config.make by "make wasm"))
endif
ifneq ($(filter all install install-bin install-dev check bench dist,$(MAKECMDGOALS)),)
$(error PLATFORM=emscripten supports only the wasm-* goals)
endif

# platform configuration

# WASM_ARCH (recorded in config.make by "make wasm") selects the target:
# wasm64 (the default: 64-bit words and pointers, emscripten's MEMORY64,
# so CHICKEN is a 64-bit platform as on x86-64) or wasm32 (32-bit, for
# engines without memory64).  Objects of the two cannot be linked
# together.
WASM_ARCH ?= wasm64
# -m64 selects emcc's wasm64-unknown-emscripten target (MEMORY64=1;
# emscripten 6 deprecates -sMEMORY64 in its favour).
ifeq ($(WASM_ARCH),wasm64)
WASM_ARCH_FLAG = -m64
# The heap may grow past 4 GB: V8 (Chrome, node) accepts up to 16 GB.
WASM_DEFAULT_MAXIMUM_MEMORY = 17179869184
# Objects are twice as big, so the nursery must be too (apply with
# 10000 arguments needs 320 KB), but the engine's frames are bigger:
# a larger pad keeps the frame count low (see C_WASM_MAX_NURSERY).
WASM_DEFAULT_FRAME_PAD = 128
# exnref: all memory64 engines have it but Chrome and Edge 133 to 136
# and node 24.0 to 24.14
WASM_DEFAULT_SJLJ = wasm
else ifeq ($(WASM_ARCH),wasm32)
WASM_ARCH_FLAG = -m32
# 2 GB, not 4: pointers stay below 2^31, which JS glue may see signed.
WASM_DEFAULT_MAXIMUM_MEMORY = 2147483648
# JavaScriptCore (Safari, every iOS browser: the engines without
# memory64) has big frames and 512 KB worker stacks: few frames between
# minor GCs, with a nursery fixed at 256 KB (see C_WASM_MAX_NURSERY)
WASM_DEFAULT_FRAME_PAD = 1024
# the compatibility build: legacy EH runs in older engines too
WASM_DEFAULT_SJLJ = wasm-legacy
else
$(error WASM_ARCH must be wasm64 or wasm32, not "$(WASM_ARCH)")
endif

ARCH = $(WASM_ARCH)
STATICBUILD = 1
EXE =

C_COMPILER ?= emcc
EMBIN = $(if $(findstring /,$(C_COMPILER)),$(dir $(C_COMPILER)),)
CXX_COMPILER ?= $(EMBIN)em++
LIBRARIAN ?= $(EMBIN)emar
LIBRARIAN_OPTIONS = crs

# knobs (normally recorded in config.make by "make wasm")

WASM_SJLJ ?= $(WASM_DEFAULT_SJLJ)
WASM_STACK_SIZE ?= 4194304
WASM_MAXIMUM_MEMORY ?= $(WASM_DEFAULT_MAXIMUM_MEMORY)
WASM_INITIAL_MEMORY ?= 33554432
WASM_FRAME_PAD ?= $(WASM_DEFAULT_FRAME_PAD)
# setjmp/longjmp (minor GCs, restarts): "wasm" lowers them to wasm
# exception handling with the standard exnref instructions (try_table),
# "wasm-legacy" with the legacy ones (try, which Firefox reports as
# deprecated), "emscripten" to JS exceptions.  The flags apply to
# compiling and linking alike.  WASM_EH tells the page what to check for.
ifeq ($(WASM_SJLJ),wasm)
WASM_SJLJ_FLAGS = -sSUPPORT_LONGJMP=wasm -sWASM_LEGACY_EXCEPTIONS=0
WASM_EH = exnref
else ifeq ($(WASM_SJLJ),wasm-legacy)
WASM_SJLJ_FLAGS = -sSUPPORT_LONGJMP=wasm -sWASM_LEGACY_EXCEPTIONS=1
WASM_EH = legacy
else ifeq ($(WASM_SJLJ),emscripten)
WASM_SJLJ_FLAGS = -sSUPPORT_LONGJMP=emscripten
WASM_EH = none
else
$(error WASM_SJLJ must be wasm, wasm-legacy or emscripten, not "$(WASM_SJLJ)")
endif
WASM_EMFLAGS = $(WASM_ARCH_FLAG) $(WASM_SJLJ_FLAGS)

# WASM_WEB_ARCHS (recorded in config-web.make by "make wasm", apart from
# the other settings): the architectures the web page offers, WASM_ARCH
# among them; the page picks one at run time (emscripten/web/repl.js).
# The modules of WASM_ARCH are beside the page, those of another
# architecture A in web/A/, built in the subdirectory arch-A here (see
# "web flavour" below).  It is built with A's defaults for the settings
# whose defaults depend on the architecture: WASM_DEFAULT_EH_A is the
# exception handling that gives it.
-include config-web.make
WASM_WEB_CONFIG := $(wildcard config-web.make)
WASM_WEB_ARCHS ?= $(WASM_ARCH)
# (not for wasm-clean, which removes every architecture's build: it
# must work whatever was recorded)
ifneq ($(strip $(MAKECMDGOALS)),wasm-clean)
ifneq ($(filter-out wasm64 wasm32,$(WASM_WEB_ARCHS)),)
$(error WASM_WEB_ARCHS must list wasm64 and wasm32 only, not "$(WASM_WEB_ARCHS)")
endif
ifeq ($(filter $(WASM_ARCH),$(WASM_WEB_ARCHS)),)
$(error WASM_WEB_ARCHS ("$(WASM_WEB_ARCHS)") must include WASM_ARCH ($(WASM_ARCH)))
endif
endif
WASM_WEB_OTHER = $(sort $(filter-out $(WASM_ARCH),$(WASM_WEB_ARCHS)))
WASM_DEFAULT_EH_wasm64 = exnref
WASM_DEFAULT_EH_wasm32 = legacy
# for the page: "ARCH:EH" each, WASM_ARCH's first
WASM_WEB_BUILDS = $(WASM_ARCH):$(WASM_EH) $(foreach a,$(WASM_WEB_OTHER),$a:$(WASM_DEFAULT_EH_$a))

# WASM_EGGS and the host tools that build them, recorded apart (see
# "eggs" below)
-include config-eggs.make
-include config-host.make
WASM_EGG_CONFIG := $(wildcard config-eggs.make)
WASM_HOST_CONFIG := $(wildcard config-host.make)
WASM_HOST_CSI ?= env LD_LIBRARY_PATH=$(SRCDIR) CHICKEN_REPOSITORY_PATH=$(SRCDIR) $(SRCDIR)csi

# options

# No -DHAVE_CHICKEN_CONFIG_H: see INCLUDES.  NO_DLOAD2 must be global:
# runtime.c defines it only for itself, library.scm tests it separately.
# It is defined empty, as runtime.c does, to avoid a redefinition warning.
C_COMPILER_OPTIONS ?= -fno-strict-aliasing -fwrapv -DNO_DLOAD2= $(WASM_EMFLAGS) \
  -DC_WASM_FRAME_PAD=$(WASM_FRAME_PAD)
ifdef WASM_SIMD
# never -mrelaxed-simd: it reintroduces FP contraction (see srfi-4.scm)
C_COMPILER_OPTIONS += -msimd128
endif
ifdef DEBUGBUILD
C_COMPILER_OPTIMIZATION_OPTIONS ?= -g -Wall -Wno-unused -O0
WASM_LINK_OPT ?= -g -O0 -sASSERTIONS=2 -sSTACK_OVERFLOW_CHECK=2
else
C_COMPILER_OPTIMIZATION_OPTIONS ?= -O2
WASM_LINK_OPT ?= -O2
endif
C_COMPILER_SHARED_OPTIONS =
LINKER_LINK_SHARED_PROGRAM_OPTIONS =
# chicken.h's '#include "chicken-config.h"' would find the HOST header in
# $(SRCDIR); force-include ours instead.
INCLUDES = -include $(CURDIR)/chicken-config.h -I. -I$(SRCDIR) -I$(SRCDIR)emscripten
LIBRARIES = -lm

# -Wl,--stack-first is NOT the default at -O1 and above (static data sits
# below the stack otherwise); with it a large overflow traps instead of
# corrupting data.  The nursery clamp in runtime.c is the main guard.
WASM_COMMON_LDFLAGS = $(WASM_EMFLAGS) $(WASM_LINK_OPT) -Wl,--stack-first \
  -sSTACK_SIZE=$(WASM_STACK_SIZE) -sINITIAL_MEMORY=$(WASM_INITIAL_MEMORY) \
  -sALLOW_MEMORY_GROWTH=1 -sMAXIMUM_MEMORY=$(WASM_MAXIMUM_MEMORY)
LINKER_OPTIONS = $(WASM_COMMON_LDFLAGS)

# special files

CHICKEN_CONFIG_H = chicken-config.h

# select default and internal settings

include $(SRCDIR)defaults.make

chicken-config.h: chicken-defaults.h
	echo "/* GENERATED */" >$@.tmp
	for d in HAVE_DIRENT_H HAVE_DLFCN_H HAVE_INTTYPES_H HAVE_LIMITS_H HAVE_LONG_LONG \
	  HAVE_MEMMOVE HAVE_MEMORY_H HAVE_SIGACTION HAVE_SIGPROCMASK HAVE_STDINT_H \
	  HAVE_STDLIB_H HAVE_STRERROR HAVE_STRINGS_H HAVE_STRING_H HAVE_STRTOLL \
	  HAVE_SYS_STAT_H HAVE_SYS_TYPES_H HAVE_SETENV HAVE_UNISTD_H \
	  HAVE_UNSIGNED_LONG_LONG STDC_HEADERS HAVE_ALLOCA HAVE_ALLOCA_H \
	  HAVE_ERRNO_H HAVE_SYSEXITS_H HAVE_STRLCPY HAVE_STRLCAT; do \
	  echo "#define $$d 1" >>$@.tmp; done
	echo "#define C_STACK_GROWS_DOWNWARD 1" >>$@.tmp
ifdef GCHOOKS
	echo "#define C_GC_HOOKS" >>$@.tmp
endif
	echo "#define C_USE_STD_FEATURE_MACROS" >>$@.tmp
	cat $@.tmp chicken-defaults.h >$@.tmp2
	rm $@.tmp
	mv $@.tmp2 $@

# chicken-defaults.h has the C compiler options (C_INSTALL_CFLAGS,
# C_TARGET_CFLAGS), but config.make not their defaults, which depend on
# the architecture (the frame pad): a record of their own, replaced only
# when they change.
chicken-defaults.h: wasm-cflags
.PHONY: wasm-cflags.force
wasm-cflags: wasm-cflags.force
	echo '$(C_COMPILER_OPTIONS) $(C_COMPILER_OPTIMIZATION_OPTIONS)' >$@.tmp
	if cmp -s $@.tmp $@; then rm $@.tmp; else mv $@.tmp $@; fi

include $(SRCDIR)rules.make

# Source-only directory search: host outputs in $(SRCDIR) (objects,
# archives, chicken-config.h, chicken-defaults.h) must never satisfy our
# targets.  Generated sources (*.c, *.import.scm) are shared with the
# host tree, which "make wasm" brings up to date first.
VPATH :=
vpath %.scm $(SRCDIR) $(SRCDIR)emscripten
vpath %.c $(SRCDIR) $(SRCDIR)emscripten
vpath %.in $(SRCDIR)emscripten
vpath chicken.h $(SRCDIR)
vpath webrepl.h $(SRCDIR)emscripten
vpath types.db $(SRCDIR)
vpath %.js $(SRCDIR)emscripten/web
vpath %.html $(SRCDIR)emscripten/web
vpath chicken.png $(SRCDIR)

.DEFAULT_GOAL := wasm-all

# build-version.scm reads "buildversion" (like "buildid" and "buildbranch",
# which identify-me writes here) from the current directory.
buildversion: $(SRCDIR)buildversion
	cp $< $@
build-version.c: buildversion

# extra units and program variants (translated with the host chicken)

# the import libraries csi.c depends on, taken from its rule in rules.make
CSI_IMPORTS = $(filter %.import.scm,$(shell sed -n '/^csi.c:/,/^[^\t ]/p' $(SRCDIR)rules.make | tr -d '\\'))

# config.make: DEBUGBUILD (WASM_DEBUG) changes the translation options
wasm-units.c: wasm-units.scm eval-modules.scm config.make $(WASM_CHICKEN_BIN)
	$(CHICKEN) $< $(CHICKEN_LIBRARY_OPTIONS) -output-file $@
wasm-egg-units.c: wasm-egg-units.scm config.make $(WASM_CHICKEN_BIN)
	$(CHICKEN) $< $(CHICKEN_LIBRARY_OPTIONS) -output-file $@
webio.c: webio.scm webrepl.h chicken.base.import.scm chicken.fixnum.import.scm \
    chicken.port.import.scm chicken.platform.import.scm chicken.bytevector.import.scm \
    chicken.foreign.import.scm chicken.time.import.scm config.make $(WASM_CHICKEN_BIN)
	$(CHICKEN) $< $(CHICKEN_LIBRARY_OPTIONS) -output-file $@
# the notebook kernel, linked into the web csi (entered with -e)
webnb.c: webnb.scm webrepl.h chicken.base.import.scm chicken.condition.import.scm \
    chicken.fixnum.import.scm chicken.foreign.import.scm chicken.port.import.scm \
    chicken.string.import.scm chicken.syntax.import.scm chicken.time.import.scm \
    chicken.bytevector.import.scm chicken.load.import.scm chicken.platform.import.scm \
    config.make $(WASM_CHICKEN_BIN)
	$(CHICKEN) $< $(CHICKEN_LIBRARY_OPTIONS) -output-file $@
csi-node.c: csi.scm banner.scm mini-srfi-1.scm $(CSI_IMPORTS) config.make $(WASM_CHICKEN_BIN)
	$(CHICKEN) $< $(CHICKEN_PROGRAM_OPTIONS) -uses wasm-units -output-file $@
# webnb.scm: csi-web initialises the units it names with -uses (so a
# build directory older than the notebook kernel retranslates it)
csi-web.c: csi.scm banner.scm mini-srfi-1.scm $(CSI_IMPORTS) webnb.scm config.make $(WASM_CHICKEN_BIN)
	$(CHICKEN) $< $(CHICKEN_PROGRAM_OPTIONS) -uses webio -uses webnb -output-file $@

WASM_CC = $(C_COMPILER) $(C_COMPILER_OPTIONS) $(C_COMPILER_COMPILE_OPTION) \
  $(C_COMPILER_OPTIMIZATION_OPTIONS)

wasm-units$(O) wasm-egg-units$(O) webio$(O) webnb$(O) csi-node$(O): %$(O): %.c chicken.h $(CHICKEN_CONFIG_H)
	$(WASM_CC) $< $(C_COMPILER_OUTPUT) $(INCLUDES)
csi-web$(O): csi-web.c chicken.h $(CHICKEN_CONFIG_H)
	$(WASM_CC) -DC_EMBEDDED $< $(C_COMPILER_OUTPUT) $(INCLUDES)
webrepl-main$(O): webrepl-main.c webrepl.h chicken.h $(CHICKEN_CONFIG_H)
	$(WASM_CC) $< $(C_COMPILER_OUTPUT) $(INCLUDES)

# repository image: all import libraries and types.db at $(EGGDIR)

WASM_STAGE = stage
WASM_REPO = $(WASM_STAGE)$(EGGDIR)

# config.make: the repository path depends on WASM_PREFIX.  The whole
# stage goes, so no tree of an earlier prefix (or egg set) lingers;
# csc-wasm's rule and the node wrappers refill it.
wasm-repo.stamp: config.make $(WASM_EGG_CONFIG) $(IMPORT_LIBRARIES:=.import.scm) types.db
	rm -rf $(WASM_STAGE)
	mkdir -p $(WASM_REPO)
	cp $(filter-out config.make $(WASM_EGG_CONFIG),$^) $(WASM_REPO)/
	touch $@

# eggs (WASM_EGGS, recorded in config-eggs.make by "make wasm"): each
# extension of these eggs and of their dependencies is compiled with
# the SDK's csc-wasm as a static unit and linked into csi (node and
# web), with its import library in the repository image.  The rules
# are in wasm-eggs.mk, planned by emscripten/wasm-eggs.scm (run by the
# host csi) from the .egg files.  wasm-units uses the unit
# wasm-egg-units, which initialises each egg unit on demand (see
# below); without eggs it is empty.  The eggs have a record of their
# own, so that changing WASM_EGGS rebuilds only the eggs that change,
# the repository image and the programs.

WASM_EGG_DIR = eggs
WASM_CSC = $(WASM_STAGE)$(BINDIR)/csc-wasm
# what every egg object depends on, besides csc-wasm (order only: it
# is rewritten whenever the stage is)
WASM_EGG_DEPS = config.make chicken.h $(CHICKEN_CONFIG_H) $(WASM_CHICKEN_BIN) \
  $(IMPORT_LIBRARIES:=.import.scm) types.db
# The host chicken compiling an egg reads the import libraries of the
# eggs built before (csc-wasm puts the core's first); code the egg runs
# at compile time (import-for-syntax) must be compiled for the host, as
# in any cross build: it comes from the host's repository.
WASM_EGG_REPOSITORY_PATH = $(CURDIR)/$(WASM_EGG_DIR)/repo$(if $(WASM_HOST_REPOSITORY),:$(WASM_HOST_REPOSITORY))

ifneq ($(strip $(WASM_EGGS)),)
WASM_REPO_STAMP = wasm-eggs-repo.stamp
ifeq ($(filter wasm-clean,$(MAKECMDGOALS)),)
include wasm-eggs.mk
endif
else
WASM_REPO_STAMP = wasm-repo.stamp
endif

# config-host.make: the egg cache and the host repository (where
# build-dependencies must be) are inputs too; a new plan rebuilds only
# the eggs whose sources come from elsewhere.
wasm-eggs.mk: wasm-eggs.scm config.make $(WASM_EGG_CONFIG) $(WASM_HOST_CONFIG) $(SRCDIR)setup.defaults
	$(if $(WASM_EGG_CACHE),CHICKEN_EGG_CACHE="$(WASM_EGG_CACHE)") \
	  WASM_EGGS_CHICKEN_INSTALL="$(WASM_HOST_CHICKEN_INSTALL)" WASM_EGGS_ARCH=$(WASM_ARCH) \
	  WASM_EGGS_HOST_REPOSITORY="$(WASM_HOST_REPOSITORY)" WASM_EGGS_CORE="$(IMPORT_LIBRARIES)" \
	  WASM_EGGS_DEFAULTS="$(SRCDIR)setup.defaults" WASM_EGG_DIR="$(WASM_EGG_DIR)" \
	  WASM_EGGS_RESERVED="$(LIBCHICKEN_SCHEME_OBJECTS_1) posix eval-modules wasm-units wasm-egg-units webio webnb" \
	  $(WASM_HOST_CSI) -s $< $@ $(WASM_EGGS)

# The egg units are initialised when first required (by "import"), as
# they would be loaded natively, not at startup: eval's load-extension
# cannot find a statically linked unit, so wasm-egg-units wraps it.  A
# unit's toplevel initialises the units it requires.  It is replaced
# only when it changes (the set of units rarely does), behind a stamp.
wasm-egg-units.scm: wasm-egg-units.stamp ;
wasm-egg-units.stamp: $(WASM_EGG_CONFIG) $(if $(strip $(WASM_EGGS)),wasm-eggs.mk)
	{ echo ';;;; GENERATED BY make from WASM_EGGS: the egg units linked into csi'; \
	  echo '(declare (unit wasm-egg-units))'; \
	  $(if $(WASM_EGG_UNITS),echo '(set! chicken.load#load-extension'; \
	    echo '  (let ((next chicken.load#load-extension))'; \
	    echo '    (lambda (lib mod loc)'; \
	    echo '      (if (##sys#provided? lib)'; \
	    echo '          (next lib mod loc)'; \
	    echo '          (case lib'; \
	    $(foreach u,$(WASM_EGG_UNITS),echo '            (($u) (##core#callunit $u) (##sys#provide (quote $u)))';) \
	    echo '            (else (next lib mod loc)))))))';) } >wasm-egg-units.scm.tmp
	if cmp -s wasm-egg-units.scm.tmp wasm-egg-units.scm; then rm wasm-egg-units.scm.tmp; \
	  else mv wasm-egg-units.scm.tmp wasm-egg-units.scm; fi
	touch $@

# The egg import libraries (and types files) join the repository image,
# and the egg objects the SDK, as libchicken-eggs.a.  Each extension
# lists the files it installed (all the modules it defines) in
# $(WASM_EGG_DIR)/E/C.installs.  The include files the eggs install
# (c-include, scheme-include), listed in $(WASM_EGG_DIR)/E/includes.list,
# go to the same place in the SDK, for programs; the Scheme ones on the
# include path (in share/chicken) to the web image as well, through
# $(WASM_EGG_WEB_SHARE), for the REPL and the compiler there.
WASM_EGG_WEB_SHARE = $(WASM_EGG_DIR)/web-share
WASM_EGG_WEB_EMBED = $(if $(WASM_EGG_WEB_INCLUDES),--embed-file $(WASM_EGG_WEB_SHARE)@$(DATADIR))
wasm-eggs-repo.stamp: wasm-repo.stamp $(WASM_CSC) $(WASM_EGG_STAMPS) $(WASM_EGG_INCLUDE_LISTS)
	set -- $$(cat $(WASM_EGG_INSTALLS) /dev/null); test $$# -eq 0 || cp "$$@" $(WASM_REPO)/
	rm -f $(WASM_STAGE)$(LIBDIR)/libchicken-eggs$(A)
	$(if $(WASM_EGG_OBJECTS),$(LIBRARIAN) $(LIBRARIAN_OPTIONS) \
	  $(WASM_STAGE)$(LIBDIR)/libchicken-eggs$(A) $(WASM_EGG_OBJECTS))
	$(if $(WASM_EGG_INCLUDE_LISTS),l=$$(cat $(WASM_EGG_INCLUDE_LISTS)) && cd $(WASM_EGG_DIR)/prefix && \
	  for f in $$l; do \
	    d=$(CURDIR)/$(WASM_STAGE)$(PREFIX)/$$(dirname "$$f"); \
	    mkdir -p "$$d" && cp -R "$$f" "$$d/" || exit 1; \
	  done)
	rm -rf $(WASM_EGG_WEB_SHARE)
	$(foreach f,$(WASM_EGG_WEB_INCLUDES),mkdir -p $(dir $(WASM_EGG_WEB_SHARE)/$f) && \
	  cp -R $(WASM_EGG_DIR)/prefix/share/chicken/$f $(dir $(WASM_EGG_WEB_SHARE)/$f) &&) :
	touch $@

WASM_EGG_LINK = wasm-egg-units$(O) $(WASM_EGG_OBJECTS)

# node flavour (host file system and environment): testing and CLI use

# node-pre.js works around an emscripten NODERAWFS bug (see there)
WASM_NODE_PRE = $(SRCDIR)emscripten/node-pre.js
WASM_NODE_LDFLAGS = $(WASM_COMMON_LDFLAGS) -sENVIRONMENT=node -sNODERAWFS=1 \
  -sNODE_HOST_ENV=1 -sEXIT_RUNTIME=1 --pre-js $(WASM_NODE_PRE)
LIBCHICKEN_A = $(PRIMARY_LIBCHICKEN)
WASM_NODE_TOOLS = csi chicken chicken-profile chicken-status

node/csi.js: csi-node$(O) wasm-units$(O) $(WASM_EGG_LINK) $(LIBCHICKEN_A) $(WASM_NODE_PRE)
	mkdir -p node
	$(LINKER) $(WASM_NODE_LDFLAGS) csi-node$(O) wasm-units$(O) $(WASM_EGG_LINK) -o $@ $(LIBCHICKEN_A) \
	  $(WASM_EGG_LDOPTS) $(LIBRARIES)
node/chicken.js: $(COMPILER_STATIC_OBJECTS) $(LIBCHICKEN_A) $(WASM_NODE_PRE)
	mkdir -p node
	$(LINKER) $(WASM_NODE_LDFLAGS) $(COMPILER_STATIC_OBJECTS) -o $@ $(LIBCHICKEN_A) $(LIBRARIES)
node/chicken-profile.js node/chicken-status.js: node/%.js: %$(O) $(LIBCHICKEN_A) $(WASM_NODE_PRE)
	mkdir -p node
	$(LINKER) $(WASM_NODE_LDFLAGS) $< -o $@ $(LIBCHICKEN_A) $(LIBRARIES)

# sh wrappers: node/csi etc. run like the native tools.  The staged
# repository comes first, before any of CHICKEN_REPOSITORY_PATH (which
# may name a host repository): only it has the import libraries, as
# source, of the eggs linked in.  The include path defaults to the
# staged share/chicken (in place of $(DATADIR), which is not on the
# host), where the eggs' Scheme include files are.
$(addprefix node/,$(WASM_NODE_TOOLS)): node/%: node/%.js $(WASM_REPO_STAMP)
	{ echo '#!/bin/sh'; \
	  echo 'd=$$(cd "$$(dirname "$$0")" && pwd)'; \
	  echo 'CHICKEN_REPOSITORY_PATH=$$d/../$(WASM_REPO)$${CHICKEN_REPOSITORY_PATH:+:$$CHICKEN_REPOSITORY_PATH}'; \
	  echo 'CHICKEN_INCLUDE_PATH=$${CHICKEN_INCLUDE_PATH-$$d/../$(WASM_STAGE)$(DATADIR)}'; \
	  echo 'export CHICKEN_REPOSITORY_PATH CHICKEN_INCLUDE_PATH'; \
	  echo 'exec "$${NODE:-node}" $${NODE_OPTIONS_WASM} "$$d/$*.js" "$$@"'; } >$@
	chmod +x $@

# web flavour: the REPL page, its worker and the in-browser compiler

WEB_DIR = web
WASM_WEB_LDFLAGS = $(WASM_COMMON_LDFLAGS) -sENVIRONMENT=web,worker,node \
  -sMODULARIZE=1 -sFORCE_FILESYSTEM=1 --embed-file $(WASM_REPO)@$(EGGDIR) $(WASM_EGG_WEB_EMBED)
WEB_ASSETS = repl.js repl-driver.js repl-worker.js compiler-worker.js nb-kernel.js \
  notebook.js notebook-lib.js chicken.png
WEB_MODULES = chicken-repl.js chicken-repl.wasm chicken-compiler.js chicken-compiler.wasm

# On wasm64 JS sees pointers as BigInt; SIGNATURE_CONVERSIONS makes
# webrepl_feed and webrepl_post take their pointer as a Number, as
# _malloc and stringToNewUTF8 give it (no effect on wasm32).
$(WEB_DIR)/chicken-repl.js: csi-web$(O) webio$(O) webnb$(O) wasm-units$(O) webrepl-main$(O) \
    $(WASM_EGG_LINK) $(LIBCHICKEN_A) $(WASM_REPO_STAMP)
	mkdir -p $(WEB_DIR)
	$(LINKER) $(WASM_WEB_LDFLAGS) -sEXPORT_NAME=createChickenRepl -sEXIT_RUNTIME=0 -Wl,--wrap=_exit \
	  -sEXPORTED_FUNCTIONS=_main,_webrepl_feed,_webrepl_post,_webrepl_resume,_webrepl_interrupt,_webrepl_state,_webrepl_started,_webrepl_exited,_webrepl_exit_code,_webrepl_wakeup_ms,_webrepl_set_slice_ms,_malloc,_free \
	  -sSIGNATURE_CONVERSIONS=webrepl_feed:_p__,webrepl_post:_p_ \
	  -sEXPORTED_RUNTIME_METHODS=FS,ENV,stringToNewUTF8,lengthBytesUTF8,HEAPU8 \
	  csi-web$(O) webio$(O) webnb$(O) wasm-units$(O) webrepl-main$(O) $(WASM_EGG_LINK) -o $@ $(LIBCHICKEN_A) \
	  $(WASM_EGG_LDOPTS) $(LIBRARIES)

$(WEB_DIR)/chicken-compiler.js: $(COMPILER_STATIC_OBJECTS) $(LIBCHICKEN_A) $(WASM_REPO_STAMP)
	mkdir -p $(WEB_DIR)
	$(LINKER) $(WASM_WEB_LDFLAGS) -sEXPORT_NAME=createChickenCompiler -sINVOKE_RUN=0 -sEXIT_RUNTIME=1 \
	  -sEXPORTED_RUNTIME_METHODS=FS,callMain \
	  $(COMPILER_STATIC_OBJECTS) -o $@ $(LIBCHICKEN_A) $(LIBRARIES)

$(addprefix $(WEB_DIR)/,$(WEB_ASSETS)): $(WEB_DIR)/%: %
	mkdir -p $(WEB_DIR)
	cp $< $@

# The other architectures of the page (WASM_WEB_ARCHS): A is built in
# arch-A, a build directory of its own, whose config.make is this one
# with WASM_ARCH = A and without the settings whose defaults depend on
# the architecture (WASM_SJLJ, WASM_FRAME_PAD, WASM_MAXIMUM_MEMORY); the
# eggs and the host tools are the same.  Its files are replaced only
# when they change, and its make runs every time: it rebuilds what a
# change there needs, and its modules are copied to web/A when they
# changed.  (The sed keeps to POSIX: one expression per setting.)
WEB_OTHER_MODULES = $(foreach a,$(WASM_WEB_OTHER),$(addprefix $(WEB_DIR)/$a/,$(WEB_MODULES)))

ifneq ($(WASM_WEB_OTHER),)
# Settings given on the host make command line reach this make in the
# environment too (MAKEOVERRIDES empties only MAKEFLAGS), and from here
# the make of arch-A: there they would take the place of A's defaults.
unexport WASM_SJLJ WASM_FRAME_PAD WASM_MAXIMUM_MEMORY WASM_WEB_ARCHS
.PHONY: $(WASM_WEB_OTHER:%=arch-%.make)
$(WASM_WEB_OTHER:%=arch-%.make): arch-%.make:
	mkdir -p arch-$*
	{ echo "# GENERATED BY make from ../config.make, for WASM_WEB_ARCHS"; \
	  sed -e '/^#/d' -e '/^WASM_ARCH *=/d' -e '/^WASM_SJLJ *=/d' -e '/^WASM_FRAME_PAD *=/d' \
	    -e '/^WASM_MAXIMUM_MEMORY *=/d' config.make; \
	  echo "WASM_ARCH = $*"; } >arch-$*/config.make.tmp
	for f in config.make config-eggs.make config-host.make; do \
	  test $$f = config.make || cat $$f >arch-$*/$$f.tmp 2>/dev/null || : >arch-$*/$$f.tmp; \
	  if cmp -s arch-$*/$$f.tmp arch-$*/$$f; then rm arch-$*/$$f.tmp; \
	  else mv arch-$*/$$f.tmp arch-$*/$$f; fi; \
	done
	+$(MAKE) -C arch-$* -f $(SRCDIR)GNUmakefile $(addprefix $(WEB_DIR)/,$(filter %.js,$(WEB_MODULES)))

define WASM_WEB_ARCH_RULES
$(addprefix arch-$1/$(WEB_DIR)/,$(WEB_MODULES)): arch-$1.make ;
$(WEB_DIR)/$1/%: arch-$1/$(WEB_DIR)/%
	mkdir -p $$(@D)
	cp $$< $$@
endef
$(foreach a,$(WASM_WEB_OTHER),$(eval $(call WASM_WEB_ARCH_RULES,$a)))
endif

# @ARCH@ tells the page to check for memory64 (wasm64), @EH@ for exnref,
# for its own modules; @BUILDS@ lists every architecture it has, with
# its exception handling (WASM_WEB_BUILDS).  The directories of
# architectures no longer listed go.  The page passes @BUILD@ as ?v= on
# every URL it loads, so browsers never mix cached files of two builds:
# the build id alone would not change between rebuilds of an uncommitted
# tree, hence the checksum, over the modules of every architecture.
$(WEB_DIR)/index.html: index.html buildid $(WASM_WEB_CONFIG) \
    $(addprefix $(WEB_DIR)/,$(WEB_ASSETS) $(filter %.js,$(WEB_MODULES))) $(WEB_OTHER_MODULES)
	mkdir -p $(WEB_DIR)
	for a in wasm64 wasm32; do \
	  case " $(WASM_WEB_OTHER) " in *" $$a "*) ;; *) rm -rf $(WEB_DIR)/$$a ;; esac; \
	done
	v="$$(cat buildid)-$$(cat $(filter $(WEB_DIR)/%,$^) $(WEB_DIR)/*.wasm | cksum | cut -d' ' -f1)"; \
	  sed -e "s/@BUILD@/$$v/g" -e "s/@ARCH@/$(WASM_ARCH)/g" -e "s/@EH@/$(WASM_EH)/g" \
	    -e "s/@BUILDS@/$(strip $(WASM_WEB_BUILDS))/g" $< >$@

# SDK: compile user programs (translated by a host chicken) to wasm

WASM_SDK_SHARE = $(WASM_STAGE)$(SHAREDIR)/chicken

# csc-wasm stands for the whole SDK, which the eggs are built with
wasm-sdk: $(WASM_CSC) $(WASM_REPO_STAMP) wasm-host-repo.stamp

# csc-wasm hides the host chicken's own repository behind the staged
# one; it adds WASM_HOST_REPOSITORY after it, as the egg builds do, for
# eggs that run code of other eggs at compile time (import-for-syntax).
# A file of its own, so that a change does not rebuild csc-wasm.
wasm-host-repo.stamp: $(WASM_CSC) $(WASM_HOST_CONFIG)
	echo '$(WASM_HOST_REPOSITORY)' >$(WASM_SDK_SHARE)/host-repository
	touch $@
# There is no shared library: libchicken.a, the name a link without
# -static asks for (as "csc" of "make wasm-cross" does), is the static
# one, so that such links work too.
$(WASM_CSC): $(LIBCHICKEN_A) chicken-config.h chicken.h wasm-repo.stamp csc-wasm.in $(WASM_NODE_PRE)
	mkdir -p $(WASM_STAGE)$(LIBDIR) $(WASM_STAGE)$(CHICKENINCDIR) $(WASM_SDK_SHARE) $(WASM_STAGE)$(BINDIR)
	cp $(LIBCHICKEN_A) $(WASM_STAGE)$(LIBDIR)/
	ln -sf $(notdir $(LIBCHICKEN_A)) $(WASM_STAGE)$(LIBDIR)/libchicken$(A)
	cp $(filter %chicken.h,$^) chicken-config.h $(WASM_STAGE)$(CHICKENINCDIR)/
	echo '$(C_COMPILER_OPTIONS) $(C_COMPILER_OPTIMIZATION_OPTIONS)' >$(WASM_SDK_SHARE)/emcflags
	echo '$(WASM_COMMON_LDFLAGS)' >$(WASM_SDK_SHARE)/emldflags
	echo '-feature emscripten -feature $(WASM_ARCH)' >$(WASM_SDK_SHARE)/features
	cp $(WASM_NODE_PRE) $(WASM_SDK_SHARE)/
	sed -e 's|@CHICKEN@|$(CHICKEN)|' -e 's|@EMCC@|$(C_COMPILER)|' \
	  -e 's|@STAGE@|$(abspath $(WASM_STAGE))$(PREFIX)|' -e 's|@REPO@|$(abspath $(WASM_REPO))|' \
	  $(filter %csc-wasm.in,$^) >$@.tmp
	chmod +x $@.tmp
	mv $@.tmp $@

# goals

.PHONY: wasm-all wasm-lib wasm-node wasm-web wasm-sdk wasm-check wasm-check-eggs wasm-serve \
  wasm-clean

wasm-lib: $(LIBCHICKEN_A)
wasm-node: $(addprefix node/,$(WASM_NODE_TOOLS))
wasm-web: $(WEB_DIR)/chicken-repl.js $(WEB_DIR)/chicken-compiler.js $(WEB_DIR)/index.html \
  $(addprefix $(WEB_DIR)/,$(WEB_ASSETS)) $(WEB_OTHER_MODULES)
wasm-all: wasm-lib wasm-node wasm-web wasm-sdk

WASM_TESTS_RUN = tests-run
# Resolved by the shell: make's own lookup of a plain "node" command
# stops at the first "node" on the PATH even if it is a directory (as in
# the emsdk root, which emsdk_env.sh puts on the PATH).
NODE ?= $(firstword $(shell command -v node) node)

# The harnesses of the page's modules, $1 being "--arch=A" for those of
# another architecture A of the page (WASM_WEB_ARCHS).
define WASM_WEB_HARNESSES
	$(NODE) $(SRCDIR)tests/wasm/repl-harness.js $(CURDIR)/$(WEB_DIR) $1
	$(NODE) --liftoff --no-wasm-tier-up --stack-size=900 $(SRCDIR)tests/wasm/repl-harness.js \
	  $(CURDIR)/$(WEB_DIR) $1
	$(NODE) $(SRCDIR)tests/wasm/worker-harness.js $(CURDIR)/$(WEB_DIR) $1
	$(NODE) $(SRCDIR)tests/wasm/notebook-harness.js $(CURDIR)/$(WEB_DIR) $1
	$(NODE) --liftoff --no-wasm-tier-up --stack-size=900 $(SRCDIR)tests/wasm/notebook-harness.js \
	  $(CURDIR)/$(WEB_DIR) $1
endef

# The page's wasm32 modules in JavaScriptCore's shell, with the stack of
# a Darwin worker (512 KB, as on iOS) and with less: only when JSC names
# a jsc (see tests/wasm/jsc-stack.js).
WASM_JSC_MODULES = $(if $(filter wasm32,$(WASM_ARCH)),$(WEB_DIR),$(if $(filter wasm32,$(WASM_WEB_OTHER)),$(WEB_DIR)/wasm32))
define WASM_JSC_LANE
	for b in 524288 393216; do \
	  $(JSC) --maxPerThreadStackUsage=$$b $(SRCDIR)tests/wasm/jsc-stack.js -- \
	    $(CURDIR)/$(WASM_JSC_MODULES) $(SRCDIR)emscripten/web/repl-driver.js || exit 1; \
	done
endef

# (WASM_WEB_OTHER has one architecture at most: a foreach of the
# multi-line WASM_WEB_HARNESSES would join two with a space)
wasm-check: wasm-node wasm-web wasm-sdk
	rm -rf $(WASM_TESTS_RUN) && mkdir -p $(WASM_TESTS_RUN)
	cd $(WASM_TESTS_RUN) && TEST_DIR=$(abspath $(SRCDIR))/tests WASM_DIR=$(CURDIR)/node \
	  WASM_WEB_DIR=$(CURDIR)/$(WEB_DIR) WASM_WEB_OTHER="$(WASM_WEB_OTHER)" \
	  WASM_SDK=$(abspath $(WASM_STAGE))$(PREFIX) \
	  HOSTCHICKEN="$(CHICKEN)" WASM_ARCH=$(WASM_ARCH) NODE="$(NODE)" sh $(SRCDIR)tests/wasm-smoke.sh
	cd $(WASM_TESTS_RUN) && TEST_DIR=$(abspath $(SRCDIR))/tests WASM_DIR=$(CURDIR)/node \
	  WASM_SDK=$(abspath $(WASM_STAGE))$(PREFIX) HOSTCHICKEN="$(CHICKEN)" \
	  sh $(SRCDIR)tests/runtests-wasm.sh
	$(call WASM_WEB_HARNESSES)
	$(foreach a,$(WASM_WEB_OTHER),$(call WASM_WEB_HARNESSES,--arch=$a))
	$(if $(and $(JSC),$(WASM_JSC_MODULES)),$(WASM_JSC_LANE))
	+$(MAKE) -f $(SRCDIR)GNUmakefile wasm-check-eggs

# The eggs lane builds csi (node and web) and the SDK in a build
# directory of its own, with the eggs of tests/wasm/eggs, then runs
# tests/wasm-eggs.sh.  It starts from copies of the outputs here (not
# the stamps, which stand for directories), so only the eggs, the
# repository image and the programs linking them are built there.  It
# works offline: no egg is retrieved.  wasm-egg-tool, the
# build-dependency of wasm-egg-c, is in an egg cache of its own, and
# installed in a host repository of its own as chicken-install would:
# its import library compiled by the host chicken and its .egg-info.
WASM_EGGS_TEST_BUILD = $(WASM_TESTS_RUN)/eggs-build
WASM_TEST_EGGS = $(abspath $(SRCDIR))/tests/wasm/eggs
WASM_TEST_HOST_REPO = $(abspath $(WASM_EGGS_TEST_BUILD))/host-repository

wasm-check-eggs: wasm-node wasm-web wasm-sdk
	rm -rf $(WASM_EGGS_TEST_BUILD) && mkdir -p $(WASM_EGGS_TEST_BUILD)
	find . -maxdepth 1 -type f ! -name '*.stamp' ! -name config-eggs.make ! -name config-host.make \
	  ! -name config-web.make ! -name wasm-eggs.mk ! -name 'wasm-egg-units.*' -exec cp -p {} $(WASM_EGGS_TEST_BUILD)/ \;
	{ echo "# GENERATED BY make wasm-check-eggs"; \
	  echo "WASM_EGGS = $(WASM_TEST_EGGS)/wasm-egg-b $(WASM_TEST_EGGS)/wasm-egg-a" \
	    "$(WASM_TEST_EGGS)/wasm-egg-c"; } \
	  >$(WASM_EGGS_TEST_BUILD)/config-eggs.make
	mkdir -p $(WASM_TEST_HOST_REPO) $(WASM_EGGS_TEST_BUILD)/egg-cache
	cp -R $(WASM_TEST_EGGS)/wasm-egg-tool $(WASM_EGGS_TEST_BUILD)/egg-cache/
	cd $(WASM_TEST_HOST_REPO) && env CHICKEN_REPOSITORY_PATH=$(abspath $(SRCDIR)) $(CHICKEN) \
	  $(WASM_TEST_EGGS)/wasm-egg-tool/wasm-egg-tool.scm -dynamic -emit-all-import-libraries -output-file tool.c && rm tool.c
	echo '((version "1.1") (installed-files))' >$(WASM_TEST_HOST_REPO)/wasm-egg-tool.egg-info
	{ echo "# GENERATED BY make wasm-check-eggs"; \
	  echo "WASM_HOST_CSI = $(WASM_HOST_CSI)"; \
	  echo "WASM_HOST_REPOSITORY = $(WASM_TEST_HOST_REPO)"; \
	  echo "WASM_EGG_CACHE = $(abspath $(WASM_EGGS_TEST_BUILD))/egg-cache"; } \
	  >$(WASM_EGGS_TEST_BUILD)/config-host.make
	+$(MAKE) -C $(WASM_EGGS_TEST_BUILD) -f $(abspath $(SRCDIR))/GNUmakefile \
	  node/csi $(WEB_DIR)/chicken-repl.js wasm-sdk
	cd $(WASM_TESTS_RUN) && EGG_BUILD=eggs-build TEST_DIR=$(abspath $(SRCDIR))/tests \
	  HOST_CSI="$(WASM_HOST_CSI)" NODE="$(NODE)" MAKE="$(MAKE)" sh $(SRCDIR)tests/wasm-eggs.sh

wasm-serve: wasm-web
	cd $(WEB_DIR) && python3 -m http.server $${PORT:-8080}

wasm-clean:
	-rm -rf node $(WEB_DIR) arch-wasm64 arch-wasm32 $(WASM_STAGE) $(WASM_TESTS_RUN) $(WASM_EGG_DIR) \
	  *.stamp *$(O) *$(A) \
	  wasm-units.c webio.c webnb.c csi-node.c csi-web.c chicken-config.h chicken-defaults.h \
	  wasm-cflags wasm-eggs.mk wasm-egg-units.scm wasm-egg-units.c \
	  $(DISTFILES) buildid buildbranch buildversion *.import.scm
